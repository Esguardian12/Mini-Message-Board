<!-- views/message.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <h1>Message Details</h1>
    <p><strong>Author:</strong> <%= message.user %></p>
    <p><strong>Message:</strong> <%= message.text %></p>
    <p><strong>Posted on:</strong> <%= message.added.toLocaleString() %></p>
    <a href="/">Back to All Messages</a>
  </body>
</html>
