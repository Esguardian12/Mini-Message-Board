<!-- views/form.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <h1>Post a New Message</h1>
    <form method="POST" action="/new">
      <div>
        <label for="messageUser">Author Name:</label>
        <input type="text" id="messageUser" name="messageUser" required />
      </div>
      <div>
        <label for="messageText">Message:</label>
        <input type="text" id="messageText" name="messageText" required />
      </div>
      <button type="submit">Submit</button>
    </form>
    <a href="/">Back to Messages</a>
  </body>
</html>
