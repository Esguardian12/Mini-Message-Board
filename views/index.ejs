<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <h1><%= title %></h1>
    <a href="/new">+ New Message</a>

    <ul>
      <% messages.forEach((message, index) => { %>
        <li>
          <strong><%= message.user %></strong>: <%= message.text %>
          <br />
          <small><%= message.added.toLocaleString() %></small>
          <a href="/message/<%= index %>">Open</a>
        </li>
      <% }) %>
    </ul>
  </body>
</html>
